# Copy to .env for local development. Never commit .env.
# For EAS builds these are set as EAS environment variables, not from this file.
# See SUPABASE_SETUP.md.

# --- Supabase (client) -------------------------------------------------------
# Project Settings -> API. The anon key is safe to ship: it grants nothing on
# its own because every table is protected by row-level security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- EAS ---------------------------------------------------------------------
EAS_PROJECT_ID=your-eas-project-id

# --- Environment -------------------------------------------------------------
NODE_ENV=development

# NOTE: There is deliberately no Gemini key here. It is a Supabase Edge Function
# secret (`supabase secrets set GEMINI_API_KEY=...`) and must never be given an
# EXPO_PUBLIC_ prefix — anything with that prefix is inlined into the app bundle
# at build time and can be extracted from a shipped binary.
